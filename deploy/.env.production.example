# Copy to deploy/.env.production and fill in real values before deploying.
# NEVER commit the filled-in .env.production file.

# --- Server / access placeholders (fill in for your environment) -----
# SERVER_IP=203.0.113.10
# SSH_USER=deploy
# DEPLOYMENT_PATH=/opt/dtbeach-supply-control
# DOMAIN=suministro.dtbeach.example.com

# --- Django ------------------------------------------------------------
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_DOMAIN_OR_SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_DOMAIN

# --- Database ------------------------------------------------------------
POSTGRES_DB=dtbeach
POSTGRES_USER=dtbeach
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Email (optional, for notifications — leave blank if not configured) --
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Backup target (optional, used by backup.sh) --------------------------
# BACKUP_REMOTE_TARGET=user@backup-host:/srv/backups/dtbeach
